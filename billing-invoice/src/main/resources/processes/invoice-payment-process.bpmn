    <bpmn:sequenceFlow id="Flow_11zlv7x" name="Oui" sourceRef="Gateway_1lam67v" targetRef="Activity_02s8q6k">
      <bpmn:conditionExpression xsi:type="bpmn:tFormalExpression">${montantTtc &gt; 10000}</bpmn:conditionExpression>
    </bpmn:sequenceFlow>
    <bpmn:sequenceFlow id="Flow_0srfqtr" name="Non" sourceRef="Gateway_1lam67v" targetRef="Activity_1k2tv88">
      <bpmn:conditionExpression xsi:type="bpmn:tFormalExpression">${montantTtc &lt;= 10000}</bpmn:conditionExpression>
    </bpmn:sequenceFlow>
    <bpmn:sequenceFlow id="Flow_151bxpt" sourceRef="Activity_02s8q6k" targetRef="Activity_1k2tv88" />
    <bpmn:exclusiveGateway id="Gateway_0txohco" name="Paiement Réussi">
      <bpmn:incoming>Flow_0iad20k</bpmn:incoming>
      <bpmn:outgoing>Flow_02xsn16</bpmn:outgoing>
      <bpmn:outgoing>Flow_0nyb8vi</bpmn:outgoing>
