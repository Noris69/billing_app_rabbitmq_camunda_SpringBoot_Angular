    <bpmn:serviceTask id="Activity_01gpil7" name="Marquer facture PAYEE" camunda:delegateExpression="${markInvoicePaidDelegate}">
      <bpmn:incoming>Flow_02xsn16</bpmn:incoming>
      <bpmn:outgoing>Flow_1ry0d12</bpmn:outgoing>
