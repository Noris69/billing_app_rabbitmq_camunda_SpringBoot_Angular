    <bpmn:serviceTask id="Activity_0j9u1l0" name="Marquer facture&#10;EN_ATTENTE" camunda:delegateExpression="${markInvoicePendingDelegate}">
      <bpmn:incoming>Flow_0nyb8vi</bpmn:incoming>
