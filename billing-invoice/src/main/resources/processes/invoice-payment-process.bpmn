    <bpmn:exclusiveGateway id="Gateway_1lam67v" name="Validation nécessaire">
      <bpmn:incoming>Flow_1fzq2hn</bpmn:incoming>
      <bpmn:outgoing>Flow_11zlv7x</bpmn:outgoing>
      <bpmn:outgoing>Flow_0srfqtr</bpmn:outgoing>
