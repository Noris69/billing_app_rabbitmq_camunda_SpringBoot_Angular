    <bpmn:sequenceFlow id="Flow_0iad20k" sourceRef="Activity_1k2tv88" targetRef="Gateway_0txohco" />
    <bpmn:sequenceFlow id="Flow_02xsn16" name="Oui" sourceRef="Gateway_0txohco" targetRef="Activity_01gpil7">
      <bpmn:conditionExpression xsi:type="bpmn:tFormalExpression">${paymentSuccess == true}</bpmn:conditionExpression>
    </bpmn:sequenceFlow>
    <bpmn:sequenceFlow id="Flow_0nyb8vi" name="Non" sourceRef="Gateway_0txohco" targetRef="Activity_0j9u1l0">
      <bpmn:conditionExpression xsi:type="bpmn:tFormalExpression">${paymentSuccess == false}</bpmn:conditionExpression>
    </bpmn:sequenceFlow>
    <bpmn:endEvent id="Event_08jk6ty" name="End Event">
